--========================================================--
--                    FOLLOW PLAYER
--========================================================--

local connection

local function followPlayer(dt)

	if not shuold then
		return
	end

	if not character or not character.Parent then
		return
	end

	if not deergod or not deergod.Parent then
		return
	end

	if not basepart or not basepart.Parent then
		return
	end

	hrp = character:FindFirstChild("HumanoidRootPart")

	if not hrp then
		return
	end

	local currentPos = basepart.Position
	local targetPos = hrp.Position

	local distance =
		(targetPos - currentPos).Magnitude

	if distance <= 0.5 then
		return
	end

	local direction =
		(targetPos - currentPos).Unit

	local newPos =
		currentPos + direction * FOLLOW_SPEED * dt

	local lookTarget =
		Vector3.new(
			targetPos.X,
			newPos.Y,
			targetPos.Z
		)

	if (lookTarget - newPos).Magnitude > 0.001 then

		deergod:PivotTo(
			CFrame.lookAt(
				newPos,
				lookTarget
			)
		)

	else

		deergod:PivotTo(
			CFrame.new(newPos)
		)
	end
end

connection = RunService.RenderStepped:Connect(function(dt)

	if not shuold
		or not deergod
		or not deergod.Parent
		or not basepart
		or not basepart.Parent then

		if connection then
			connection:Disconnect()
			connection = nil
		end

		return
	end

	followPlayer(dt)
end)

