--========================================================--
--                 GITHUB SOUND LOADER
--========================================================--

local function GetGitSound(GithubSnd, SoundName)

	if not (writefile and isfile and game.HttpGet) then
		warn("Executor không hỗ trợ file functions")
		return nil
	end

	local getasset = getcustomasset or getsynasset

	if not getasset then
		warn("Executor không hỗ trợ custom asset")
		return nil
	end

	local fileName = SoundName .. ".mp3"

	if not isfile(fileName) then

		local success, content = pcall(function()
			return game:HttpGet(GithubSnd)
		end)

		if not success or not content then
			warn("Không tải được nhạc")
			return nil
		end

		local successWrite = pcall(function()
			writefile(fileName, content)
		end)

		if not successWrite then
			warn("Không ghi được file nhạc")
			return nil
		end
	end

	local sound = Instance.new("Sound")

	local success, soundId = pcall(function()
		return getasset(fileName)
	end)

	if not success or not soundId then
		sound:Destroy()
		return nil
	end

	sound.SoundId = soundId

	return sound
end

