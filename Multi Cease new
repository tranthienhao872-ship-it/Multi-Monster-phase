---====== Entity Model ======---

local entityModel: Model? = nil

local function TryFindEntityModel(
    entityTable: any
): Model?

    local ok, result =
        pcall(function()

            return entityTable.Model
                or entityTable.Instance
                or entityTable.Rig
                or entityTable.Character

        end)

    if ok
        and result
        and typeof(result) == "Instance" then

        if result:IsA("Model") then
            return result
        end
    end

    for _, inst in ipairs(
        Workspace:GetDescendants()
    ) do

        if inst:IsA("Model")
            and inst.Name == "Cease" then

            return inst
        end
    end

    return nil
end

local function ResolveEntityModel(
    entityTable: any
)

    task.spawn(function()

        for attempt = 1, 20 do

            local found =
                TryFindEntityModel(
                    entityTable
                )

            if found then

                entityModel = found

                print(
                    "[Cease] Found:",
                    found:GetFullName()
                )

                return
            end

            task.wait(0.25)
        end

        warn(
            "[Cease] Cannot find entity model."
        )
    end)
end

local function SetEntityDamageAttribute(
    state: boolean
)

    if not entityModel then
        return
    end

    if not entityModel.Parent then
        return
    end

    pcall(function()

        entityModel:SetAttribute(
            "Damage",
            state
        )

    end)
end

