---====== Cease Spawn Sounds ======---

local SPAWN_SOUND_1_ID = "rbxassetid://166047422"
local SPAWN_SOUND_2_ID = "rbxassetid://9125632539"

local SPAWN_SOUND_VOLUME = 12

local SPAWN_SOUND_1_PITCH = 1
local SPAWN_SOUND_2_PITCH = 0.5

local spawnSound1 = nil
local spawnSound2 = nil

local function CreateSpawnSounds()

    -- Xóa sound cũ nếu script bị chạy lại
    local old1 = SoundService:FindFirstChild("CeaseSpawnSound1")
    if old1 then
        old1:Destroy()
    end

    local old2 = SoundService:FindFirstChild("CeaseSpawnSound2")
    if old2 then
        old2:Destroy()
    end

    -- Sound 1
    spawnSound1 = Instance.new("Sound")
    spawnSound1.Name = "CeaseSpawnSound1"
    spawnSound1.SoundId = SPAWN_SOUND_1_ID
    spawnSound1.Volume = SPAWN_SOUND_VOLUME
    spawnSound1.PlaybackSpeed = SPAWN_SOUND_1_PITCH
    spawnSound1.Looped = false
    spawnSound1.Parent = SoundService

    -- Sound 2
    spawnSound2 = Instance.new("Sound")
    spawnSound2.Name = "CeaseSpawnSound2"
    spawnSound2.SoundId = SPAWN_SOUND_2_ID
    spawnSound2.Volume = SPAWN_SOUND_VOLUME
    spawnSound2.PlaybackSpeed = SPAWN_SOUND_2_PITCH
    spawnSound2.Looped = false
    spawnSound2.Parent = SoundService
end

local function PlaySpawnSounds()

    if not spawnSound1 or not spawnSound1.Parent then
        CreateSpawnSounds()
    end

    if not spawnSound2 or not spawnSound2.Parent then
        CreateSpawnSounds()
    end

    -- Reset về đầu
    spawnSound1.TimePosition = 0
    spawnSound2.TimePosition = 0

    -- PLAY CÙNG LÚC
    spawnSound1:Play()
    spawnSound2:Play()
end

