---====== Kiểm tra The Mines ======---

local function IsInTheMines()

    local currentRooms =
        Workspace:FindFirstChild("CurrentRooms")

    if not currentRooms then
        return false
    end

    local character = player.Character

    if not character then
        return false
    end

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return false
    end

    -- Cách 1: Game có Attribute/Name báo Mines
    local floor = Workspace:GetAttribute("Floor")

    if floor then
        local floorText = tostring(floor):lower()

        if floorText:find("mines") then
            return true
        end
    end

    -- Cách 2: tìm folder/instance Mines
    for _, obj in ipairs(Workspace:GetChildren()) do

        local name = obj.Name:lower()

        if name == "the mines"
            or name == "mines"
            or name:find("mines") then

            return true
        end
    end

    -- Cách 3: kiểm tra room hiện tại
    for _, room in ipairs(
        currentRooms:GetChildren()
    ) do

        if room:IsA("Model") then

            local roomPart =
                room:FindFirstChild("RoomEntrance")
                or room:FindFirstChild("Entrance")
                or room.PrimaryPart

            if roomPart
                and roomPart:IsA("BasePart") then

                local distance =
                    (
                        hrp.Position
                        - roomPart.Position
                    ).Magnitude

                if distance < 100 then

                    local roomName =
                        room.Name:lower()

                    if roomName:find("mine") then
                        return true
                    end
                end
            end
        end
    end

    return false
end

local minesCheckConnection = nil

local function StartMinesReverbCheck()

    if minesCheckConnection then
        return
    end

    minesCheckConnection =
        RunService.Heartbeat:Connect(
        function()

            if not spawnSound1
                or not spawnSound1.Parent then

                return
            end

            local inMines =
                IsInTheMines()

            if inMines ~= minesReverbEnabled then

                SetMinesReverb(inMines)

            end
        end
    )
end

