---====== Player Room ======---

local function GetPlayerRoom(): Model?

    local hrp = GetHRP()

    if not hrp then
        return nil
    end

    local currentRooms =
        Workspace:FindFirstChild(
            "CurrentRooms"
        )

    if not currentRooms then
        return nil
    end

    local closestRoom = nil
    local closestDistance = math.huge

    for _, room in ipairs(
        currentRooms:GetChildren()
    ) do

        if room:IsA("Model") then

            local roomPart =
                room:FindFirstChild(
                    "RoomEntrance"
                )
                or room:FindFirstChild(
                    "Entrance"
                )
                or room.PrimaryPart

            if roomPart
                and roomPart:IsA("BasePart") then

                local distance =
                    (
                        hrp.Position
                        - roomPart.Position
                    ).Magnitude

                if distance < closestDistance then

                    closestDistance = distance
                    closestRoom = room

                end
            end
        end
    end

    return closestRoom
end

---====== Entity Room ======---

local function GetEntityRoom(): Model?

    if not entityModel then
        return nil
    end

    if not entityModel.Parent then
        return nil
    end

    local entityPart =
        entityModel.PrimaryPart
        or entityModel:FindFirstChild(
            "HumanoidRootPart"
        )
        or entityModel:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if not entityPart
        or not entityPart:IsA("BasePart") then

        return nil
    end

    local currentRooms =
        Workspace:FindFirstChild(
            "CurrentRooms"
        )

    if not currentRooms then
        return nil
    end

    local closestRoom = nil
    local closestDistance = math.huge

    for _, room in ipairs(
        currentRooms:GetChildren()
    ) do

        if room:IsA("Model") then

            local roomPart =
                room:FindFirstChild(
                    "RoomEntrance"
                )
                or room:FindFirstChild(
                    "Entrance"
                )
                or room.PrimaryPart

            if roomPart
                and roomPart:IsA("BasePart") then

                local distance =
                    (
                        entityPart.Position
                        - roomPart.Position
                    ).Magnitude

                if distance < closestDistance then

                    closestDistance = distance
                    closestRoom = room

                end
            end
        end
    end

    return closestRoom
end

---====== States ======---

local isEntityActive = false
local movePenaltyEnabled = false
local ceaseInPlayerRoom = false

local ceaseRebounding = false

local scanConnection:
    RBXScriptConnection? = nil

local lastAttributeState:
    boolean? = nil

local VELOCITY_THRESHOLD = 0.05

---====== Same Room ======---

local function IsCeaseInPlayerRoom(): boolean

    if not entityModel then
        return false
    end

    local playerRoom =
        GetPlayerRoom()

    local ceaseRoom =
        GetEntityRoom()

    if not playerRoom
        or not ceaseRoom then

        return false
    end

    return playerRoom == ceaseRoom
end

local function UpdateCeaseRoomState()

    if not isEntityActive then

        ceaseInPlayerRoom = false

        return
    end

    -- Rebound thì không xử lý room
    if ceaseRebounding then
        return
    end

    local sameRoom =
        IsCeaseInPlayerRoom()

    if sameRoom then

        ceaseInPlayerRoom = true

    else

        ceaseInPlayerRoom = false

        if lastAttributeState ~= false then

            SetEntityDamageAttribute(false)

            lastAttributeState = false

        end
    end
end

---====== Movement Scan ======---

local function StartMoveScan()

    if scanConnection then
        return
    end

    scanConnection =
        RunService.Heartbeat:Connect(
        function()

            if not isEntityActive then
                return
            end

            if not movePenaltyEnabled then
                return
            end

            -- REBOUND PROTECTION
            if ceaseRebounding then

                if lastAttributeState ~= false then

                    SetEntityDamageAttribute(
                        false
                    )

                    lastAttributeState = false
                end

                return
            end

            UpdateCeaseRoomState()

            -- Chưa cùng phòng
            if not ceaseInPlayerRoom then

                if lastAttributeState ~= false then

                    SetEntityDamageAttribute(
                        false
                    )

                    lastAttributeState = false
                end

                return
            end

            local humanoid =
                GetHumanoid()

            if not humanoid then
                return
            end

            if humanoid.Health <= 0 then
                return
            end

            -- Trốn tủ
            if IsPlayerHiding() then

                if lastAttributeState ~= false then

                    SetEntityDamageAttribute(
                        false
                    )

                    lastAttributeState = false
                end

                return
            end

            local hrp =
                GetHRP()

            if not hrp then
                return
            end

            local velocity =
                hrp.AssemblyLinearVelocity

            local horizontalSpeed =
                Vector2.new(
                    velocity.X,
                    velocity.Z
                ).Magnitude

            local isMoving =
                horizontalSpeed >
                VELOCITY_THRESHOLD

            if isMoving then

                if lastAttributeState ~= true then

                    print(
                        "[Cease] MOVING -> DAMAGE 100"
                    )

                    SetEntityDamageAttribute(
                        true
                    )

                    lastAttributeState = true
                end

            else

                if lastAttributeState ~= false then

                    SetEntityDamageAttribute(
                        false
                    )

                    lastAttributeState = false
                end
            end
        end
    )
end

local function StopMoveScan()

    if scanConnection then

        scanConnection:Disconnect()

        scanConnection = nil
    end

    lastAttributeState = nil
    ceaseInPlayerRoom = false
    ceaseRebounding = false

    SetEntityDamageAttribute(false)
end

