        "HumanoidRootPart"
    ) :: BasePart?
end

local function CreatePlayerLight()

    local hrp = GetHRP()

    if not hrp then
        return
    end

    local existing =
        hrp:FindFirstChild(
            "CeaseBlueLight"
        )

    if existing then
        existing:Destroy()
    end

    local light =
        Instance.new("PointLight")

    light.Name = "CeaseBlueLight"
    light.Color =
        Color3.fromRGB(
            60,
            120,
            255
        )

    light.Range = LIGHT_RANGE
    light.Brightness = 0
    light.Shadows = true

    light.Parent = hrp

    blueLight = light
end

local function FadeLight(
    target: number,
    duration: number
)

    if not blueLight
        or not blueLight.Parent then

        CreatePlayerLight()
    end

    if blueLight then

        local tween =
            TweenService:Create(
                blueLight,

                TweenInfo.new(
                    duration,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                ),

                {
                    Brightness = target
                }
            )

        tween:Play()
    end
end

