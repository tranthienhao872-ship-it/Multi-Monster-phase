entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")

    isEntityActive = true
    movePenaltyEnabled = false
    lastAttributeState = nil

    -- Đảm bảo lúc đầu Damage attribute = false (an toàn) cho tới khi có model + đủ điều kiện
    SetEntityDamageAttribute(false)

    StartMoveScan()
    StartHideDamageLoop()

    local fadeTween = FadeTo(BLUE_VISIBLE_TRANSPARENCY, FADE_DURATION)
    FadeLight(LIGHT_MAX_BRIGHTNESS, FADE_DURATION)

    task.spawn(function()
        fadeTween.Completed:Wait()
        if isEntityActive then
            movePenaltyEnabled = true
        end
    end)
end)

