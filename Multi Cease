screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 999
screenGui.IgnoreGuiInset = true
screenGui.Parent = playerGui

local blueFrame = Instance.new("Frame")
blueFrame.Name = "BlueOverlay"
blueFrame.Size = UDim2.new(1, 0, 1, 0)
blueFrame.Position = UDim2.new(0, 0, 0, 0)
blueFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
blueFrame.BorderSizePixel = 0
blueFrame.BackgroundTransparency = 1
blueFrame.ZIndex = 999
blueFrame.Parent = screenGui

local BLUE_VISIBLE_TRANSPARENCY = 0.35
local FADE_DURATION = 2

local function FadeTo(target: number, duration: number)
	local tween = TweenService:Create(
		blueFrame,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{BackgroundTransparency = target}
	)
	tween:Play()
	return tween
end

---====== Tạo Light xanh dương bao quanh người chơi ======---

local blueLight: PointLight? = nil
local LIGHT_MAX_BRIGHTNESS = 2.5
local LIGHT_RANGE = 100

local function GetHRP(): BasePart?
	local character = player.Character or player.CharacterAdded:Wait()
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function CreatePlayerLight()
	local hrp = GetHRP()
	if not hrp then return end

	local existing = hrp:FindFirstChild("CeaseBlueLight")
	if existing then existing:Destroy() end

	local light = Instance.new("PointLight")
	light.Name = "CeaseBlueLight"
	light.Color = Color3.fromRGB(255, 0, 0)
	light.Range = LIGHT_RANGE
	light.Brightness = 0
	light.Shadows = true
	light.Parent = hrp

	blueLight = light
end

local function FadeLight(target: number, duration: number)
	if not blueLight or not blueLight.Parent then
		CreatePlayerLight()
	end
	if blueLight then
		local tween = TweenService:Create(
			blueLight,
			TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Brightness = target}
		)
		tween:Play()
	end
end

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	CreatePlayerLight()
end)
CreatePlayerLight()

