---====== Tìm model của entity trong workspace (để toggle Attribute "Damage") ======---

local entityModel: Model? = nil

local function TryFindEntityModel(entityTable: any): Model?
	-- Thử 1: entity trả về có thể tự chứa property trỏ tới model
	local ok, result = pcall(function()
		return entityTable.Model or entityTable.Instance or entityTable.Rig or entityTable.Character
	end)
	if ok and result and typeof(result) == "Instance" then
		return result :: Model
	end

	-- Thử 2: quét workspace tìm model tên đúng "Cease" có Attribute "Damage" tồn tại
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Model") and inst.Name == "Cease" then
			return inst
		end
	end

	return nil
end

local function ResolveEntityModel(entityTable: any)
	-- Thử nhiều lần vì model có thể spawn trễ hơn 1 chút so với callback OnSpawned
	task.spawn(function()
		for attempt = 1, 10 do
			local found = TryFindEntityModel(entityTable)
			if found then
				entityModel = found
				print("[Cease] Đã tìm thấy entity model để điều khiển Attribute Damage:", found:GetFullName())
				return
			end
			task.wait(0.3)
		end
		warn("[Cease] KHÔNG tìm được entity model sau nhiều lần thử. Cơ chế toggle Attribute 'Damage' sẽ KHÔNG hoạt động — báo lại để đổi hướng khác.")
	end)
end

local function SetEntityDamageAttribute(state: boolean)
	if entityModel then
		local ok = pcall(function()
			entityModel:SetAttribute("Damage", state)
		end)
		if not ok then
			warn("[Cease] Lỗi khi set Attribute 'Damage' trên entity model.")
		end
	end
end

---====== Theo dõi di chuyển: chỉ toggle Attribute "Damage" của entity, KHÔNG tự TakeDamage ======---

local isEntityActive = false
local movePenaltyEnabled = false
local hideLoopRunning = false

local HIDE_DAMAGE_PER_SECOND = 25
local VELOCITY_THRESHOLD = 0.05

local function GetHumanoid(): Humanoid?
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

-- Xác nhận từ source thật của module: nó tự đọc chính Attribute "Hiding" này để bỏ qua damage khi trốn tủ
local function IsPlayerHiding(): boolean
	local character = player.Character
	if not character then return false end
	return character:GetAttribute("Hiding") == true
end

-- Trốn tủ vẫn phải tự trừ máu bằng tay, vì module không có cơ chế phạt trốn tủ, chỉ có cơ chế BỎ QUA damage khi trốn tủ
local function StartHideDamageLoop()
	if hideLoopRunning then return end
	hideLoopRunning = true

	task.spawn(function()
		while hideLoopRunning do
			task.wait(1)
			if not isEntityActive then break end

			if movePenaltyEnabled and IsPlayerHiding() then
				local humanoid = GetHumanoid()
				if humanoid and humanoid.Health > 0 then
					humanoid:TakeDamage(HIDE_DAMAGE_PER_SECOND)
				end
			end
		end
		hideLoopRunning = false
	end)
end

local function StopHideDamageLoop()
	hideLoopRunning = false
end

-- Di chuyển: KHÔNG tự TakeDamage nữa. Chỉ bật/tắt Attribute "Damage" trên entity model,
-- để chính module tự trừ máu (Range + inSight + không trốn tủ) -> Guiding Light thật tự nói.
local scanConnection: RBXScriptConnection? = nil
local lastAttributeState: boolean? = nil

local function StartMoveScan()
	if scanConnection then return end

	scanConnection = RunService.Heartbeat:Connect(function()
		if not isEntityActive or not movePenaltyEnabled then return end

		local humanoid = GetHumanoid()
		if not humanoid or humanoid.Health <= 0 then return end

		if IsPlayerHiding() then
			if lastAttributeState ~= false then
				SetEntityDamageAttribute(false)
				lastAttributeState = false
			end
			return
		end

		local hrp = GetHRP()
		if not hrp then return end

		local velocity = hrp.AssemblyLinearVelocity
		local horizontalSpeed = Vector2.new(velocity.X, velocity.Z).Magnitude
		local isMoving = horizontalSpeed > VELOCITY_THRESHOLD

		if isMoving then
			if lastAttributeState ~= true then
				SetEntityDamageAttribute(true)
				lastAttributeState = true
			end
		else
			if lastAttributeState ~= false then
				SetEntityDamageAttribute(false)
				lastAttributeState = false
			end
		end
	end)
end

local function StopMoveScan()
	if scanConnection then
		scanConnection:Disconnect()
		scanConnection = nil
	end
	lastAttributeState = nil
	SetEntityDamageAttribute(false)
end

