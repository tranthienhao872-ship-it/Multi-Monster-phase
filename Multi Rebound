---====== Jumpscare Function ======---

local function PlayJumpscare()
	local existingGui = playerGui:FindFirstChild("ReboundJumpscareGui")
	if existingGui then
		existingGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ReboundJumpscareGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.Parent = playerGui

	local bg = Instance.new("Frame")
	bg.Name = "Background"
	bg.Size = UDim2.fromScale(1, 1)
	bg.Position = UDim2.fromScale(0, 0)
	bg.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	bg.BackgroundTransparency = 0
	bg.BorderSizePixel = 0
	bg.Parent = screenGui

	local staticOverlay = Instance.new("ImageLabel")
	staticOverlay.Name = "StaticOverlay"
	staticOverlay.Size = UDim2.fromScale(1, 1)
	staticOverlay.Position = UDim2.fromScale(0, 0)
	staticOverlay.BackgroundTransparency = 0
	staticOverlay.ImageTransparency = 0.8
	staticOverlay.ScaleType = Enum.ScaleType.Stretch
	staticOverlay.ZIndex = 2
	staticOverlay.Parent = screenGui

	local faceImage = Instance.new("ImageLabel")
	faceImage.Name = "ReboundFace"
	faceImage.Size = UDim2.new(0, 250, 0, 250)
	faceImage.Position = UDim2.fromScale(0.5, 0.5)
	faceImage.AnchorPoint = Vector2.new(0.5, 0.5)
	faceImage.BackgroundTransparency = 1
	faceImage.Image = "rbxassetid://13272951808"
	faceImage.ImageColor3 = Color3.fromRGB(255, 0, 0)
	faceImage.ScaleType = Enum.ScaleType.Stretch
	faceImage.ZIndex = 3
	faceImage.Parent = screenGui

	local jsSound = Instance.new("Sound")
	jsSound.Name = "ReboundJumpscareSound"
	jsSound.SoundId = "rbxassetid://109582246349306"
	jsSound.Volume = 10
	jsSound.Parent = workspace

	local jsSound5 = Instance.new("Sound")
	jsSound5.Name = "ReboundJumpscareSound5"
	jsSound5.SoundId = "rbxassetid://109582246349306"
	jsSound5.Volume = 10
	jsSound5.PlaybackSpeed = Random.new():NextNumber(0.3, 0.9)
	jsSound5.Parent = workspace

	local colors = {
		Color3.fromRGB(146, 255, 237),
		Color3.fromRGB(0, 251, 255),
		Color3.fromRGB(0, 123, 255),
		Color3.fromRGB(197, 222, 255),
		Color3.fromRGB(20, 144, 182),
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(160, 206, 255)
	}

	local staticImages = {
		"rbxassetid://236777652",
		"rbxassetid://236543215"
	}

	local staticRotations = {0, -180, 180}

	local function playSoundSafe(soundObj, timePos, speed, volume)
		if not soundObj or not soundObj.Parent then return end
		pcall(function()
			soundObj:Stop()
			soundObj.TimePosition = timePos or 0
			soundObj.PlaybackSpeed = speed or 1
			soundObj.Volume = volume or 10
			soundObj:Play()
		end)
	end

	local function getRandomDifferent(tab, current)
		local picked = tab[math.random(1, #tab)]
		if picked == current then
			task.wait()
			return getRandomDifferent(tab, current)
		end
		return picked
	end

	local isJumpscaring = true

	pcall(function()
		game.SoundService.Main.Volume = 0
	end)

	playSoundSafe(jsSound, 0, math.random(75, 125) / 100, 10)

	task.spawn(function()
		local lastRot = staticOverlay.Rotation
		local lastImg = staticOverlay.Image

		while isJumpscaring and screenGui.Parent do
			task.wait(0.066666666666666666)

			local currentRot = faceImage.Rotation
			local v2

			if math.random(1, 2) == 1 then
				v2 = -currentRot
			else
				v2 = currentRot + math.random(-360, 360)
			end

			local v3 = v2 + math.random(-360, 360)

			if v3 > 180 then
				v3 = 180
			elseif v3 < -180 then
				v3 = -180
			end

			staticOverlay.BackgroundColor3 = colors[math.random(1, #colors)]
			faceImage.ImageColor3 = colors[math.random(1, #colors)]

			lastRot = getRandomDifferent(staticRotations, lastRot)
			lastImg = getRandomDifferent(staticImages, lastImg)

			staticOverlay.Rotation = lastRot
			staticOverlay.Image = lastImg
			local v10 = TweenInfo.new(0.066666666666666666)
			local v11 = math.random(150, 450)
			local v12 = math.random(75, 150)
			local v13 = {Size = UDim2.new(0, v11, 0, v12)}
			TweenService:Create(faceImage, v10, v13):Play()

			task.delay(0.03333333333333333, function()
				if faceImage and faceImage.Parent and isJumpscaring then
					local v14 = TweenInfo.new(0.05333333333333333)
					local v15 = math.random(225, 250)
					local v16 = math.random(150, 450)
					local v17 = {Size = UDim2.new(0, v15, 0, v16)}
					TweenService:Create(faceImage, v14, v17):Play()
				end
			end)

			local v19 = TweenInfo.new(0.05333333333333333, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local v20 = math.random(150, 800) / 1000
			local v21 = math.random(150, 800) / 1000
			local v22 = {
				Position = UDim2.new(v20, 0, v21, 0),
				Rotation = -v3
			}
			TweenService:Create(faceImage, v19, v22):Play()

			playSoundSafe(jsSound, 0.25 + math.random() / 10, math.random(50, 125) / 100, 10)
		end
	end)

	task.delay(2.5, function()
		if not screenGui.Parent then return end

		isJumpscaring = false
		if jsSound then jsSound:Destroy() end

		task.wait(0.1)
		pcall(function() jsSound5:Play() end)

		local climaxTween = TweenService:Create(faceImage, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, 0, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = math.random(-25, 25),
			ImageColor3 = Color3.fromRGB(255, 0, 0)
		})
		climaxTween:Play()

		task.delay(1, function()
			TweenService:Create(faceImage, TweenInfo.new(2), {ImageTransparency = 1}):Play()

			TweenService:Create(bg, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
			TweenService:Create(staticOverlay, TweenInfo.new(1), {
				BackgroundTransparency = 1,
				ImageTransparency = 1
			}):Play()

			pcall(function()
				game.SoundService.Main.Volume = 0.5
			end)

			task.delay(2, function()
				if jsSound5 then jsSound5:Destroy() end
				if screenGui then screenGui:Destroy() end
			end)
		end)
	end)
end

---====== Blue Screen + Shake Effect ======---

local ColorCorrection = Instance.new("ColorCorrectionEffect")
ColorCorrection.Name = "ReboundEffect"
ColorCorrection.TintColor = Color3.fromRGB(255, 0, 0)
ColorCorrection.Brightness = 0
ColorCorrection.Contrast = 0
ColorCorrection.Saturation = 0
ColorCorrection.Parent = Lighting

local Sound1 = Instance.new("Sound")
Sound1.Name = "ReboundSound1"
Sound1.SoundId = "rbxassetid://136836151370178"
Sound1.Volume = 5
Sound1.Parent = Camera

local Sound2 = Instance.new("Sound")
Sound2.Name = "ReboundSound2"
Sound2.SoundId = "rbxassetid://18920812603"
Sound2.Volume = 5
Sound2.Parent = Camera

local Sound3 = Instance.new("Sound")
Sound3.Name = "ReboundSound3"
Sound3.SoundId = "rbxassetid://111768657135706"
Sound3.Volume = 5
Sound3.Parent = Camera

local Sound4 = Instance.new("Sound")
Sound4.Name = "ReboundSound4"
Sound4.SoundId = "rbxassetid://9120826936"
Sound4.Volume = 5
Sound4.Parent = Camera

local Sound5 = Instance.new("Sound")
Sound5.Name = "ReboundSound5"
Sound5.SoundId = "rbxassetid://9120805470"
Sound5.Volume = 5
Sound5.Parent = Camera

local shaking = false
local shakeConnection = nil
local shakeIntensity = 0.15
local currentColorTween = nil

local function StartBlueScreen()
	pcall(function() Sound1:Stop() end)
	pcall(function() Sound2:Stop() end)
	pcall(function() Sound3:Stop() end)
	pcall(function() Sound4:Stop() end)
	pcall(function() Sound5:Stop() end)

	pcall(function() Sound1:Play() end)
	pcall(function() Sound2:Play() end)
	pcall(function() Sound3:Play() end)
	pcall(function() Sound4:Play() end)
	pcall(function() Sound5:Play() end)

	if currentColorTween then
		currentColorTween:Cancel()
		currentColorTween = nil
	end

	currentColorTween = TweenService:Create(ColorCorrection, TweenInfo.new(0.15, Enum.EasingStyle.Sine), {
		TintColor = Color3.fromRGB(255, 0, 0),
		Brightness = -0.3,
		Contrast = 0.2,
		Saturation = -0.4
	})
	currentColorTween:Play()

	if shakeConnection then
		shakeConnection:Disconnect()
		shakeConnection = nil
	end

	shaking = true
	shakeConnection = RunService.RenderStepped:Connect(function(dt)
		if not shaking then
			shakeConnection:Disconnect()
			return
		end

		local offset = Vector3.new(
			(math.random() - 0.5) * shakeIntensity,
			(math.random() - 0.5) * shakeIntensity,
			0
		)
		Camera.CFrame = Camera.CFrame * CFrame.new(offset)
	end)
end

local function EndBlueScreen()
	shaking = false

	if currentColorTween then
		currentColorTween:Cancel()
		currentColorTween = nil
	end

	currentColorTween = TweenService:Create(ColorCorrection, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TintColor = Color3.fromRGB(255, 0, 0),
		Brightness = 0,
		Contrast = 0,
		Saturation = 0
	})
	currentColorTween:Play()
end

