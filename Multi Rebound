---====== Hàm tạo & chạy Entity (100% không sợ kẹt state) ======---

local spawnCount = 0
local maxSpawns = 6
local isRespawnCycle = false
local isProcessingRoomRoll = false
local isRebounding = false
local canRollForNextSpawn = false

local function SpawnReboundEntity()
	spawnCount += 1
	print("📢 [SPAWN] Đang khởi tạo và kích hoạt Rebound lần thứ " .. spawnCount .. "/" .. maxSpawns)

	local entity = Spawner:Create({
		Entity = {
			Name = "Multi Rebound",
			Asset = "13390488111",
			HeightOffset = 0
		},
		Lights = {
			Flicker = {
				Enabled = true,
				Duration = 1
			},
			Shatter = true,
			Repair = false
		},
		Earthquake = {
			Enabled = true
		},
		CameraShake = {
			Enabled = true,
			Range = 500,
			Values = {2, 30, 0.1, 1}
		},
		Movement = {
			Speed = 95,
			Delay = 2,
			Reversed = true
		},
		Rebounding = {
			Enabled = true,
			Type = "Ambush",
			Min = 1,
			Max = 2,
			Delay = 4
		},
		Damage = {
			Enabled = true,
			Range = 40,
			Amount = 125
		},
		Crucifixion = {
			Enabled = true,
			Range = 40,
			Resist = false,
			Break = true
		},
		Death = {
			Type = "Guiding",
			Hints = {"You die by Rebound.", "If you see the screen turn blue or hear the lightning sound..hide..", "That's all...", "Good luck.."},
			Cause = "Rebound"
		}
	})

	entity:SetCallback("OnSpawned", function()
		print("📢 [SPAWN] Entity đã xuất hiện thành công!")
		if isRespawnCycle then
			isRespawnCycle = false
			pcall(function()
				Sound3.Volume = 10
				Sound3:Play()
			end)
		end
	end)

	local destroyedRooms = {}
	entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
		if room and not destroyedRooms[room] then
			destroyedRooms[room] = true

			task.spawn(function()
				task.wait(0.05)

				pcall(function()
					local breakSound = Instance.new("Sound")
					breakSound.SoundId = "rbxassetid://9114223171"
					breakSound.Volume = 2.5
					breakSound.Parent = room:FindFirstChild("Assets") or room
					breakSound:Play()
					breakSound.Ended:Connect(function() breakSound:Destroy() end)
				end)

				local assetContainer = room:FindFirstChild("Assets") or room
				local breakSounds = {
					"rbxassetid://9125992545",
					"rbxassetid://4004052860",
					"rbxassetid://7142857558",
					"rbxassetid://7142843615",
					"rbxassetid://7142857558",
					"rbxassetid://2612674531",
					"rbxassetid://2174790942"
				}
				local blacklist = {"wardrobe", "bed", "rug", "key", "drawer", "book", "breaker", "table", "desk", "gold", "dresser"}

				for _, item in pairs(assetContainer:GetChildren()) do
					if item:IsA("Model") and item.Name ~= "Door" and item.Name ~= "HidingSpots" then
						local isBlacklisted = false
						local itemNameLower = string.lower(item.Name)
						for _, word in ipairs(blacklist) do
							if string.find(itemNameLower, word) then
								isBlacklisted = true
								break
							end
						end

						if not isBlacklisted then
							local primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
							if primary then
								task.spawn(function()
									for _, v in ipairs(item:GetDescendants()) do
										if v:IsA("BasePart") then
											local lowerName = string.lower(v.Name)
											if not string.find(lowerName, "floor") and not string.find(lowerName, "hitbox") then
												task.wait(math.random(1, 4) / 100)
												local randomSoundId = breakSounds[math.random(1, #breakSounds)]

												pcall(function()
													local s = Instance.new("Sound")
													s.SoundId = randomSoundId
													s.Volume = math.random(12, 24) / 10
													s.PlaybackSpeed = math.random(85, 115) / 100
													s.RollOffMaxDistance = 100
													s.Parent = v
													s:Play()
													s.Ended:Connect(function()
														s:Destroy()
													end)
												end)

												v.Anchored = false
												v.CanCollide = true
												v.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.01, 0.5, 1, 1)

												pcall(function()
													if v:CanSetNetworkOwnership() then
														v:SetNetworkOwner(player)
													end
												end)

												v.CFrame = v.CFrame + Vector3.new(0, 0.05, 0)
											end
										end
									end
								end)

								primary.Anchored = true
								task.wait()
								primary.Anchored = false

								primary.AssemblyLinearVelocity = Vector3.new(
									math.random(-60, 60),
									math.random(20, 50),
									math.random(-60, 60)
								)

								primary.AssemblyAngularVelocity = Vector3.new(
									math.random(-25, 25),
									math.random(-25, 25),
									math.random(-25, 25)
								)
							end
						end
					end
				end
			end)
		end
	end)

	entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
		if startOfRebound == true then
			isRebounding = true
			StartBlueScreen()
		else
			isRebounding = false
			EndBlueScreen()
		end
	end)

	entity:SetCallback("OnDespawned", function()
		if spawnCount < maxSpawns then
			canRollForNextSpawn = true
			print("[Spawner] 🟢 Lần spawn này đã kết thúc. Hãy mở cửa sang phòng tiếp theo (Đã đạt: " .. spawnCount .. "/" .. maxSpawns .. ")")
		else
			print("[Spawner] 🛑 Đã hoàn thành đủ giới hạn tối đa 6/6 lần spawn!")
		end
	end)

	entity:SetCallback("OnDamagePlayer", function(newHealth: number)
		if newHealth <= 0 then
			PlayJumpscare()
		end
	end)

	entity:Run(true)
end

---====== LẮNG NGHE SỰ KIỆN PHÒNG MỚI (CHẮC CHẮN 100% ẢNH HƯỞNG) ======---
local function SetupRoomListener()
	local currentRooms = workspace:WaitForChild("CurrentRooms", 5)
	if currentRooms then
		currentRooms.ChildAdded:Connect(function(room)
			if canRollForNextSpawn and not isRebounding and not isProcessingRoomRoll and spawnCount < maxSpawns then
				isProcessingRoomRoll = true
				
				task.spawn(function()
					task.wait(1.5) -- Đợi phòng mới load ổn định hẳn
					
					-- CHỈNH TỶ LỆ Ở ĐÂY: Đang để 100% (roll <= 100) để test xem nó có chịu spawn không!
					local roll = math.random(1, 100)
					
					if roll <= 100 then
						isRespawnCycle = true
						canRollForNextSpawn = false
						print("[Spawner] 🎯 [TRÚNG SPAWN 100%] Tiến hành gọi thực thể mới cho phòng " .. room.Name)
						
						task.wait(0.5)
						SpawnReboundEntity()
					else
						print("[Spawner] ❌ [TRƯỢT SPAWN] Roll được: " .. roll)
					end
					isProcessingRoomRoll = false
				end)
			end
		end)
	else
		warn("[Spawner] Không tìm thấy workspace.CurrentRooms!")
	end
end

SetupRoomListener()

---====== Chạy lần đầu tiên ======---
SpawnReboundEntity()

