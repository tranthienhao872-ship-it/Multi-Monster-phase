        )

    Line.BorderSizePixel = 0

    Line.ZIndex =
        Window.ZIndex + 2

    Line.Parent =
        Window

    --====================================================--
    -- GLITCH BLOCK
    --====================================================--

    local GlitchBlock =
        Instance.new("Frame")

    GlitchBlock.Name =
        "GlitchBlock"

    GlitchBlock.Size =
