        )

    TimerBar.Position =
        UDim2.fromScale(
            0,
            0
        )

    TimerBar.BackgroundColor3 =
        Color3.fromRGB(
            255,
            0,
            0
        )

    TimerBar.BorderSizePixel = 0

    TimerBar.ZIndex =
        Window.ZIndex + 3

    TimerBar.Parent =
        TimerBack

    --====================================================--
    -- ERROR LINE
    --====================================================--

    local Line =
