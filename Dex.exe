        )

    TitleBar.Position =
        UDim2.fromOffset(
            0,
            0
        )

    TitleBar.BackgroundColor3 =
        Color3.fromRGB(
            125,
            0,
            0
        )

    TitleBar.BorderSizePixel = 0

    TitleBar.ZIndex =
        Window.ZIndex + 1

    TitleBar.Parent =
        Window

    --====================================================--
    -- TITLE
    --====================================================--

    local Title =
        Instance.new("TextLabel")

    Title.Name =
        "Title"

    Title.Size =
        UDim2.new(
            1,
