                    Width,
                    Height
                )
        }

    ):Play()

    --====================================================--
    -- STATE
    --====================================================--

    local Closed = false

    --====================================================--
    -- CLOSE WINDOW
    --====================================================--

    local function CloseWindow(
        IsTimeout
    )

        if Closed then
            return
        end

        Closed = true

        local CloseTween =
            TweenService:Create(

                Window,

                TweenInfo.new(
                    0.10,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.In
                ),

                {

                    Size =
                        UDim2.fromOffset(
                            0,
                            0
                        ),

                    BackgroundTransparency = 1

                }

            )

        CloseTween:Play()

        task.spawn(function()

            CloseTween.Completed:Wait()

            if Window then
                Window:Destroy()
            end

        end)

    end

       --====================================================--
    -- X BUTTON
    --====================================================--

    Close.MouseButton1Click:Connect(function()

        if Closed then
            return
        end

        -- Sound bấm X
        PlaySound(
            CLOSE_SOUND_ID
        )

        CloseWindow(false)

    end)

    --====================================================--
    -- TIMER
    --====================================================--

    task.spawn(function()

        local StartTime =
            os.clock()

        while Window.Parent
            and not Closed do

            local Elapsed =
                os.clock() -
                StartTime

            local Remaining =
                TimeLimit -
                Elapsed

            if Remaining <= 0 then
                break
            end

            local Percent =
                math.clamp(
                    Remaining /
                    TimeLimit,
                    0,
                    1
                )

            TimerBar.Size =
                UDim2.new(
                    Percent,
                    0,
                    1,
                    0
                )

            TimerLabel.Text =
                string.format(
                    "TIME: %.1f",
                    Remaining
                )

            --================================================--
            -- TIMER COLOR
            --================================================--

            if Percent <= 0.25 then

                TimerBar.BackgroundColor3 =
                    Color3.fromRGB(
                        255,
                        20,
                        20
                    )

                TimerLabel.TextColor3 =
                    Color3.fromRGB(
                        255,
                        70,
                        70
                    )

            elseif Percent <= 0.5 then

                TimerBar.BackgroundColor3 =
                    Color3.fromRGB(
                        190,
                        0,
                        0
                    )

            else

                TimerBar.BackgroundColor3 =
                    Color3.fromRGB(
                        255,
                        0,
                        0
                    )

            end

            task.wait(
                0.03
            )

        end

        --================================================--
        -- TIMEOUT
        --================================================--

        if Window.Parent
            and not Closed then

            TimerLabel.Text =
                "TIME: 0.0"

            -- Âm thanh hết thời gian
            PlaySound(
                TIMEOUT_SOUND_ID
            )

            -- Mất 29 - 89 HP
            DamagePlayer()

            -- Đóng cửa sổ
            CloseWindow(true)

        end

    end)

    --====================================================--
    -- GLITCH LOOP
    --====================================================--

    task.spawn(function()

        while Window.Parent
            and not Closed do

            task.wait(
                RandomFloat(
                    0.08,
                    0.20
                )
            )

            if not Window.Parent
                or Closed then
                break
            end

            local OldPosition =
                Window.Position

            Window.Position =
                UDim2.fromOffset(

                    X + RandomInt(
                        -4,
                        4
                    ),

                    Y + RandomInt(
                        -3,
                        3
                    )

                )

            MainText.TextColor3 =
                Color3.fromRGB(

                    255,

                    RandomInt(
                        20,
                        100
                    ),

                    RandomInt(
                        20,
                        100
                    )

                )

            GlitchBlock.Position =
                UDim2.fromOffset(

                    RandomInt(
                        5,
                        math.max(
                            6,
                            Width - 40
                        )
                    ),

                    RandomInt(
                        35,
                        math.max(
                            36,
                            Height - 20
                        )
                    )

                )

            task.wait(
                0.035
            )

            if Window.Parent
                and not Closed then

                Window.Position =
                    OldPosition

            end

        end

    end)

end

--========================================================--
-- CREATE WAVE
--========================================================--

local function CreateWave()

    if not ScreenGui.Parent then
        return
    end

    local Mobile =
        IsMobile()

    local Amount

    if Mobile then

        Amount =
            RandomInt(
                4,
                7
            )

    else

        Amount =
            RandomInt(
                6,
                11
            )

    end

    for i = 1, Amount do

        if not ScreenGui.Parent then
            break
        end

        CreateErrorWindow()

        task.wait(
            RandomFloat(
                0.05,
                0.15
            )
        )

    end

end

--========================================================--
-- FIRST WAVE
--========================================================--

task.spawn(function()

    task.wait(
        0.2
    )

    CreateWave()

end)

--========================================================--
-- NEW WAVE EVERY 3 SECONDS
--========================================================--

task.spawn(function()

    while ScreenGui.Parent do

        task.wait(
            SPAWN_INTERVAL
        )

        if not ScreenGui.Parent then
            break
        end

        CreateWave()

    end

end)

--========================================================--
-- GLOBAL GLITCH
--========================================================--

task.spawn(function()

    while ScreenGui.Parent do

        task.wait(
            RandomFloat(
                0.7,
                1.5
            )
        )

        if not ScreenGui.Parent then
            break
        end

        Background.BackgroundTransparency =
            RandomFloat(
                0.88,
                0.94
            )

        task.wait(
            0.04
        )

        if Background.Parent then

            TweenService:Create(

                Background,

                TweenInfo.new(
                    0.15
                ),

                {
                    BackgroundTransparency =
                        0.96
                }

            ):Play()

        end

    end

end)

