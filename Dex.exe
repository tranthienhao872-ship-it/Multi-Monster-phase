local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local RNG = Random.new()

--========================================================--
-- SETTINGS
--========================================================--

local SPAWN_INTERVAL = 3

local MIN_TIME = 3
local MAX_TIME = 5

local MIN_DAMAGE = 29
local MAX_DAMAGE = 89

-- Cửa sổ xuất hiện
local SPAWN_SOUND_ID = "rbxassetid://12221944"

-- Bấm X
local CLOSE_SOUND_ID = "rbxassetid://12221967"

-- Hết thời gian
local TIMEOUT_SOUND_ID = "rbxassetid://12221984"

--========================================================--
-- CLEAN OLD GUI
--========================================================--

pcall(function()

    local Old =
        PlayerGui:FindFirstChild(
            "FakeHackErrorGUI"
        )

    if Old then
        Old:Destroy()
    end

end)

--========================================================--
-- MAIN GUI
--========================================================--

local ScreenGui =
    Instance.new("ScreenGui")

ScreenGui.Name =
    "FakeHackErrorGUI"

ScreenGui.ResetOnSpawn = false

ScreenGui.IgnoreGuiInset = true

ScreenGui.ZIndexBehavior =
    Enum.ZIndexBehavior.Sibling

ScreenGui.Parent =
    PlayerGui

--========================================================--
-- CAMERA
--========================================================--

local Camera =
    workspace.CurrentCamera

local function GetScreenSize()

    if Camera then
        return Camera.ViewportSize
    end

    return Vector2.new(
        1280,
        720
    )

end

local function IsMobile()

    local Size =
        GetScreenSize()

    return Size.X < 800
        or Size.Y < 600

end

--========================================================--
-- SOUND
--========================================================--

local function PlaySound(SoundId)

    local Sound =
        Instance.new("Sound")

    Sound.SoundId =
        SoundId

    Sound.Volume = 1

    Sound.Parent =
        SoundService

    Sound:Play()

    Sound.Ended:Connect(function()

        if Sound then
            Sound:Destroy()
        end

    end)

    task.delay(
        10,
        function()

            if Sound
                and Sound.Parent then

                Sound:Destroy()

            end

        end
    )

end

