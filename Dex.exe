--========================================================--
-- RANDOM
--========================================================--

local function RandomInt(
    Min,
    Max
)

    return RNG:NextInteger(
        Min,
        Max
    )

end

local function RandomFloat(
    Min,
    Max
)

    return RNG:NextNumber(
        Min,
        Max
    )

end

local function RandomError()

    return ErrorTexts[
        RandomInt(
            1,
            #ErrorTexts
        )
    ]

end

local function RandomSmallError()

    return SmallTexts[
        RandomInt(
            1,
            #SmallTexts
        )
    ]

end

local function RandomWindowColor()

    local Colors = {

        Color3.fromRGB(
            50,
            0,
            0
        ),

        Color3.fromRGB(
            65,
            0,
            0
        ),

        Color3.fromRGB(
            80,
            0,
            0
        ),

        Color3.fromRGB(
            95,
            0,
            0
        ),

        Color3.fromRGB(
            110,
            0,
            0
        )

    }

    return Colors[
        RandomInt(
            1,
            #Colors
        )
    ]

end

--========================================================--
-- DAMAGE PLAYER
--========================================================--

local function DamagePlayer()

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then
        return
    end

    if Humanoid.Health <= 0 then
        return
    end

    local Damage =
        RandomInt(
            MIN_DAMAGE,
            MAX_DAMAGE
        )

    Humanoid.Health =
        math.max(
            0,
            Humanoid.Health - Damage
        )

    print(
        "[ERROR GUI] TIMEOUT DAMAGE:",
        Damage
    )

end

--========================================================--
-- WINDOW COUNTER
--========================================================--

local WindowCount = 0

--========================================================--
-- CREATE ERROR WINDOW
--========================================================--

local function CreateErrorWindow()

    if not ScreenGui.Parent then
        return
    end

    WindowCount += 1

    local ScreenSize =
        GetScreenSize()

    local Mobile =
        IsMobile()

    --====================================================--
    -- WINDOW SIZE
    --====================================================--

    local Width
    local Height

    if Mobile then

        Width =
            RandomInt(
                190,
                270
            )

        Height =
            RandomInt(
                130,
                170
            )

    else

        Width =
            RandomInt(
                240,
                370
            )

        Height =
            RandomInt(
                145,
                190
            )

    end

    Width =
        math.min(
            Width,
            math.max(
                170,
                math.floor(
                    ScreenSize.X - 20
                )
            )
        )

    Height =
        math.min(
            Height,
            math.max(
                120,
                math.floor(
                    ScreenSize.Y - 30
                )
            )
        )

    --====================================================--
    -- RANDOM POSITION
    --====================================================--

    local MaxX =
        math.max(
            10,
            math.floor(
                ScreenSize.X -
                Width -
                10
            )
        )

    local MaxY =
        math.max(
            10,
            math.floor(
                ScreenSize.Y -
                Height -
                10
            )
        )

    local X =
        RandomInt(
            10,
            MaxX
        )

    local Y =
        RandomInt(
            10,
            MaxY
        )

    --====================================================--
    -- RANDOM TIMER
    --====================================================--

    local TimeLimit =
        RandomFloat(
            MIN_TIME,
            MAX_TIME
        )

    --====================================================--
    -- WINDOW
    --====================================================--

    local Window =
        Instance.new("Frame")

    Window.Name =
        "ErrorWindow_" ..
        WindowCount

    Window.Size =
        UDim2.fromOffset(
            0,
            0
        )

    Window.Position =
        UDim2.fromOffset(
            X,
            Y
        )

    Window.BackgroundColor3 =
        RandomWindowColor()

    Window.BackgroundTransparency = 0

    Window.BorderSizePixel = 2

    Window.BorderColor3 =
        Color3.fromRGB(
            255,
            0,
            0
        )

    Window.ZIndex =
        100 + WindowCount

    Window.Parent =
        ScreenGui

    --====================================================--
    -- SPAWN SOUND
    --====================================================--

    PlaySound(
        SPAWN_SOUND_ID
    )

    --====================================================--
    -- CORNER
    --====================================================--

    local Corner =
