        and 10
        or 12

    TimerLabel.Font =
        Enum.Font.Code

    TimerLabel.TextXAlignment =
        Enum.TextXAlignment.Left

    TimerLabel.ZIndex =
        Window.ZIndex + 3

    TimerLabel.Parent =
        Window

    --====================================================--
    -- TIMER BACKGROUND
    --====================================================--

    local TimerBack =
        Instance.new("Frame")

    TimerBack.Name =
        "TimerBack"

    TimerBack.Size =
        UDim2.new(
            1,
            -16,
            0,
            6
        )

    TimerBack.Position =
        UDim2.new(
            0,
            8,
            1,
