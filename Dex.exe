            1,
            -RandomInt(
                20,
                60
            ),
            0,
            2
        )

    GlitchBlock.Position =
        UDim2.fromOffset(
            RandomInt(
                5,
                20
            ),
            RandomInt(
                35,
                math.max(
                    36,
                    Height - 20
                )
            )
        )

    GlitchBlock.BackgroundColor3 =
