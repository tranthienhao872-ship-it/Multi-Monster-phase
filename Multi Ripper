---====== Camera Shake Logic ======---
local isShaking = false
local camera = workspace.CurrentCamera

RunService.RenderStepped:Connect(function()
	if isShaking and camera then
		local time = tick()
		local magnitude = 1.2
		local xOffset = math.sin(time * 25) * magnitude
		local yOffset = math.cos(time * 30) * magnitude
		camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(xOffset), math.rad(yOffset), 0)
	end
end)

