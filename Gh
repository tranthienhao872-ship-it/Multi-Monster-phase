--//======================================================
--// CREATE BRIGHT BURGUNDY SCREEN
--//======================================================

local function CreateRedScreen()

	-- Remove old GUI
	if RedEffectGui then
		pcall(function()
			RedEffectGui:Destroy()
		end)

		RedEffectGui = nil
	end

	-- Remove old ColorCorrection
	if RedColorEffect then
		pcall(function()
			RedColorEffect:Destroy()
		end)

		RedColorEffect = nil
	end

	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

	--// ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "A60_1_BrightBurgundyEffect"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 999998
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	gui.Parent = PlayerGui

	RedEffectGui = gui

	--// Main red screen
	local Frame = Instance.new("Frame")

	Frame.Name = "BrightBurgundyScreen"

	Frame.Size = UDim2.fromScale(1, 1)
	Frame.Position = UDim2.fromScale(0, 0)

	--// Bright Burgundy
	Frame.BackgroundColor3 =
		Color3.fromRGB(145, 0, 35)

	Frame.BackgroundTransparency = 1
	Frame.BorderSizePixel = 0

	Frame.ZIndex = 999998
	Frame.Parent = gui

	--//==================================================
	--// FADE IN
	--//==================================================

	local fadeIn = TweenService:Create(
		Frame,

		TweenInfo.new(
			1.2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out
		),

		{
			BackgroundTransparency = 0.43
		}
	)

	fadeIn:Play()

	--//==================================================
	--// BRIGHT BURGUNDY COLOR CORRECTION
	--//==================================================

	local cc = Instance.new("ColorCorrectionEffect")

	cc.Name = "A60_1_BrightBurgundyColor"

	cc.TintColor =
		Color3.fromRGB(
			255,
			95,
			115
		)

	cc.Brightness = 0.03
	cc.Contrast = 0.18
	cc.Saturation = 0.05

	cc.Parent = Lighting

	RedColorEffect = cc
end

--//======================================================
--// REMOVE RED SCREEN
--//======================================================

local function RemoveRedScreen()

	--//==================================================
	--// FADE OUT SCREEN
	--//==================================================

	if RedEffectGui then

		local gui = RedEffectGui
		local Frame = gui:FindFirstChild(
			"BrightBurgundyScreen"
		)

		if Frame then

			local fadeOut = TweenService:Create(
				Frame,

				TweenInfo.new(
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.In
				),

				{
					BackgroundTransparency = 1
				}
			)

			fadeOut:Play()

			task.delay(0.85, function()

				if gui then
					pcall(function()
						gui:Destroy()
					end)
				end

				if RedEffectGui == gui then
					RedEffectGui = nil
				end

			end)

		else

			pcall(function()
				gui:Destroy()
			end)

			if RedEffectGui == gui then
				RedEffectGui = nil
			end
		end
	end

	--//==================================================
	--// FADE COLOR CORRECTION BACK TO NORMAL
	--//==================================================

	if RedColorEffect then

		local effect = RedColorEffect

		RedColorEffect = nil

		local tween = TweenService:Create(
			effect,

			TweenInfo.new(
				0.8,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In
			),

			{
				Brightness = 0,
				Contrast = 0,
				Saturation = 0,

				TintColor =
					Color3.fromRGB(
						255,
						255,
						255
					)
			}
		)

		tween:Play()

		task.delay(0.85, function()

			pcall(function()
				effect:Destroy()
			end)

		end)
	end
end

