--//======================================================
--// ON SPAWNED
--//======================================================

entity:SetCallback(
	"OnSpawned",
	function()

		--==================================================
		-- BRIGHT BURGUNDY SCREEN
		--==================================================

		CreateRedScreen()

		--==================================================
		-- SPAWN SOUND
		--==================================================

		local sound5 =
			Instance.new("Sound")

		sound5.Name =
			"A60_1_Intro"

		sound5.PlaybackSpeed =
			0.6

		sound5.Volume =
			15

		sound5.SoundId =
			"rbxassetid://9125713501"

		sound5.Parent =
			workspace

		local pitch =
			Instance.new(
				"PitchShiftSoundEffect"
			)

		pitch.Octave =
			1

		pitch.Parent =
			sound5

		sound5:Play()

		--==================================================
		-- CAMERA EARTHQUAKE
		--==================================================

		task.spawn(function()

			local successCam,
				CameraShaker =
				pcall(function()

					return require(
						game.ReplicatedStorage:
							WaitForChild(
								"CameraShaker"
							)
					)

				end)

			if not successCam
				or not CameraShaker then

				task.wait(5.771)

				if sound5 then

					pcall(function()
						sound5:Destroy()
					end)

				end

				return
			end

			local currentCamera =
				workspace.CurrentCamera

			if not currentCamera then
				return
			end

			local introShake

			introShake =
				CameraShaker.new(

					Enum.RenderPriority
						.Camera.Value,

					function(p143)

						if currentCamera then

							currentCamera.CFrame =
								currentCamera.CFrame
								* p143

						end
					end
				)

			introShake:Start()

			pcall(function()

				introShake:Shake(
					CameraShaker
						.Presets
						.Earthquake
				)

			end)

			task.wait(5.771)

			if sound5 then

				pcall(function()
					sound5:Destroy()
				end)

			end

			if introShake then

				pcall(function()

					introShake:
						StopSustained(0.2)

				end)

			end
		end)
	end
)

